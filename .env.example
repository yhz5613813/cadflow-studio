# Local-only web server
STUDIO_PORT=4317
# Optional: reuse an existing pi installation's configuration directory.
# PI_AGENT_DIR=/absolute/path/to/.pi/agent
# Optional default provider/model (also configurable in the UI)
PI_PROVIDER=
PI_MODEL=
# Provider API keys are read by pi on the server. Never sent to the browser.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Set this only to connect to an OpenAI-compatible custom endpoint.
STUDIO_MODEL_BASE_URL=
STUDIO_MODEL_ID=
STUDIO_MODEL_API_KEY=
# Optional application data root; defaults to .studio beside this file.
# STUDIO_DATA_DIR=/path/to/data
# Optional default Python executable. UI-saved runtime configuration takes precedence.
# STUDIO_PYTHON=/path/to/venv/bin/python
