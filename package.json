{
  "name": "cadflow-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/pi.integration.test.ts",
    "plugin:install": "tsx scripts/install-plugin.ts",
