    "@earendil-works/pi-coding-agent": "0.85.1",
    "ajv": "8.20.0",
    "codemirror": "^6.0.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "fflate": "0.8.3",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "occt-import-js": "0.0.23",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "0.178.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
